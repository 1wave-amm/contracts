# Private Key for deployment
# IMPORTANT: Never commit this file with real values!
PRIVATE_KEY=...........................

# Address that can mint tokens (e.g., Merkl Distributor)
MINTER_ADDRESS=...........................

# Access Control Manager address
ACCESS_CONTROL_MANAGER_ADDRESS=...........................

# RPC URL for deployment (optional, can be passed via --rpc-url)
RPC_URL=https://mainnet.base.org

# Basescan API Key for contract verification
# Get your free API key from: https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key_here
